+
+void llama_kv_cache_context::rg_set_input_virt_idxs(ggml_tensor * dst) const {
+    kv->rg_set_input_virt_idxs(dst);
+}
+
+ggml_tensor * llama_kv_cache::rg_cpy_virt(ggml_context * ctx, ggml_tensor * vrows, ggml_tensor * idxs, int32_t il) const {
+    return ggml_set_rows(ctx, layers[map_layer_ids.at(il)].v_hot, vrows, idxs);
