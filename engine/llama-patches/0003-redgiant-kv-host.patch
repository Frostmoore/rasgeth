diff --git a/src/llama-redgiant-attn-avx512.cpp b/src/llama-redgiant-attn-avx512.cpp
new file mode 100644
index 0000000..9ae6082
--- /dev/null
+++ b/src/llama-redgiant-attn-avx512.cpp
@@ -0,0 +1,235 @@
+// RedGiant (C.4): the fast kernel of llama-redgiant-attn.cpp, built with AVX-512 and called only when the processor has
+// AVX-512 with VNNI (checked at run time). The C.4.1 prototype (rg-test/c4/proto.cu, cpu_attn2) read the cache at the
+// RAM's speed on a Ryzen 9 9900X (60-67 GB/s): every kv head of a cell together, keys with VNNI (k+128 unsigned times q
+// signed, minus 128 x the sum of q per group of 4 bytes), 16 exps at a time.
+
+#include "llama-redgiant-attn.h"
+
+#if defined(__AVX512F__)
+
+#include <immintrin.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+constexpr int D   = 128;
+constexpr int NB  = D/32;
+constexpr int TG  = 4;   // query rows read together (several when the message is being read)
+constexpr int SUB = 32;  // cells per scoring step
+constexpr int MAXH = 64;
+
+struct block {
+    uint16_t d;
+    int8_t   q[32];
+};
+
+inline float h2f(uint16_t h) {
+    // F16C, as every compiler spells it (MSVC has no _cvtsh_ss)
+    return _mm_cvtss_f32(_mm_cvtph_ps(_mm_cvtsi32_si128(h)));
+}
+
+inline __m512 exp16(__m512 x) {
+    x = _mm512_max_ps(x, _mm512_set1_ps(-87.f));
+    const __m512 t = _mm512_mul_ps(x, _mm512_set1_ps(1.44269504f));
+    const __m512 n = _mm512_roundscale_ps(t, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
+    const __m512 f = _mm512_sub_ps(t, n);
+    __m512 p = _mm512_set1_ps(1.535336188e-4f);
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(1.339887440e-3f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(9.618437357e-3f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(5.550332471e-2f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(2.402264791e-1f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(6.931472028e-1f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(1.f));
+    return _mm512_scalef_ps(p, n);
+}
+
+inline float hsum8(__m256 v) {
+    __m128 a = _mm_add_ps(_mm256_castps256_ps128(v), _mm256_extractf128_ps(v, 1));
+    a = _mm_add_ps(a, _mm_movehl_ps(a, a));
+    a = _mm_add_ss(a, _mm_movehdup_ps(a));
+    return _mm_cvtss_f32(a);
+}
+
+}  // namespace
+
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job & j) {
+    const ggml_tensor * q = j.q;
+    const ggml_tensor * k = j.k;
+    const ggml_tensor * v = j.v;
+    const ggml_tensor * mask = j.mask;
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    const int64_t n_head_kv = k->ne[2], G = n_head/n_head_kv;
+    if (n_head > MAXH || k->ne[0] != D) {
+        return false;
+    }
+
+    alignas(64) static thread_local int8_t  qi[TG][MAXH][D];
+    alignas(64) static thread_local int32_t corr[TG][MAXH][NB][8];
+    alignas(64) static thread_local float   qd[TG][MAXH][NB];
+    alignas(64) static thread_local float   sc[TG][MAXH][SUB];
+    alignas(64) static thread_local float   acc[TG][MAXH][D];
+    static thread_local float m[TG][MAXH], l[TG][MAXH];
+
+    const __m256i flip = _mm256_set1_epi8((char) 0x80);
+
+    for (int64_t s = 0; s < ne3; s++) {
+        for (int64_t t0 = 0; t0 < n_batch; t0 += TG) {
+            const int nt = (int) std::min<int64_t>(TG, n_batch - t0);
+            // The queries of these rows in int8 per block of 32, with their scale and the VNNI correction.
+            for (int tt = 0; tt < nt; tt++) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    const float * qp = (const float *) ((const char *) q->data + (t0 + tt)*q->nb[1] + h*q->nb[2] + s*q->nb[3]);
+                    for (int b = 0; b < NB; b++) {
+                        float a = 0.0f;
+                        for (int i = 0; i < 32; i++) {
+                            a = std::max(a, std::fabs(qp[b*32 + i]));
+                        }
+                        const float d = a/127.0f;
+                        qd[tt][h][b] = d*j.scale;
+                        for (int i = 0; i < 32; i++) {
+                            qi[tt][h][b*32 + i] = (int8_t) std::lrint(d != 0.0f ? qp[b*32 + i]/d : 0.0f);
+                        }
+                        for (int g = 0; g < 8; g++) {
+                            int c = 0;
+                            for (int i = 0; i < 4; i++) {
+                                c += qi[tt][h][b*32 + g*4 + i];
+                            }
+                            corr[tt][h][b][g] = 128*c;
+                        }
+                    }
+                    m[tt][h] = -INFINITY;
+                    l[tt][h] = 0.0f;
+                    std::memset(acc[tt][h], 0, sizeof(acc[tt][h]));
+                }
+            }
+
+            for (int64_t c = j.c0; c < j.c1; c += SUB) {
+                const int len = (int) std::min<int64_t>(SUB, j.c1 - c);
+                // Scores: each cell's keys read once, every kv head, for every query row and head.
+                for (int i = 0; i < len; i++) {
+                    const int64_t cell = c + i;
+                    for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+                        const block * kb = (const block *) ((const char *) k->data + cell*k->nb[1] + kvh*k->nb[2] + s*k->nb[3]);
+                        __m256i ku[NB];
+                        float   dk[NB];
+                        for (int b = 0; b < NB; b++) {
+                            ku[b] = _mm256_xor_si256(_mm256_loadu_si256((const __m256i *) kb[b].q), flip);
+                            dk[b] = h2f(kb[b].d);
+                        }
+                        for (int64_t g = 0; g < G; g++) {
+                            const int64_t h = kvh*G + g;
+                            for (int tt = 0; tt < nt; tt++) {
+                                __m256 f = _mm256_setzero_ps();
+                                for (int b = 0; b < NB; b++) {
+                                    __m256i dot = _mm256_dpbusd_epi32(_mm256_setzero_si256(), ku[b],
+                                                                      _mm256_load_si256((const __m256i *) &qi[tt][h][b*32]));
+                                    dot = _mm256_sub_epi32(dot, _mm256_load_si256((const __m256i *) corr[tt][h][b]));
+                                    f = _mm256_fmadd_ps(_mm256_cvtepi32_ps(dot), _mm256_set1_ps(dk[b]*qd[tt][h][b]), f);
+                                }
+                                float x = hsum8(f);
+                                if (mask) {
+                                    x += h2f(*(const uint16_t *) ((const char *) mask->data + cell*mask->nb[0] +
+                                                                  (t0 + tt)*mask->nb[1] + (h % mask->ne[2])*mask->nb[2] +
+                                                                  (s % mask->ne[3])*mask->nb[3]));
+                                }
+                                sc[tt][h][i] = x;
+                            }
+                        }
+                    }
+                }
+                for (int tt = 0; tt < nt; tt++) {
+                    for (int64_t h = 0; h < n_head; h++) {
+                        for (int i = len; i < SUB; i++) {
+                            sc[tt][h][i] = -INFINITY;
+                        }
+                    }
+                }
+                // Softmax by row and head: new max, rescale, 16 exps at a time.
+                for (int tt = 0; tt < nt; tt++) {
+                    for (int64_t h = 0; h < n_head; h++) {
+                        __m512 mx = _mm512_set1_ps(m[tt][h]);
+                        for (int i = 0; i < SUB; i += 16) {
+                            mx = _mm512_max_ps(mx, _mm512_load_ps(&sc[tt][h][i]));
+                        }
+                        const float nm = _mm512_reduce_max_ps(mx);
+                        if (nm == -INFINITY) {
+                            // every cell masked so far: nothing to add
+                            for (int i = 0; i < SUB; i++) {
+                                sc[tt][h][i] = 0.0f;
+                            }
+                            continue;
+                        }
+                        const float r = std::exp(m[tt][h] - nm);
+                        if (r != 1.0f) {
+                            const __m512 rv = _mm512_set1_ps(r);
+                            for (int d = 0; d < D; d += 16) {
+                                _mm512_store_ps(&acc[tt][h][d], _mm512_mul_ps(_mm512_load_ps(&acc[tt][h][d]), rv));
+                            }
+                        }
+                        l[tt][h] *= r;
+                        m[tt][h] = nm;
+                        __m512 sum = _mm512_setzero_ps();
+                        const __m512 nmv = _mm512_set1_ps(nm);
+                        for (int i = 0; i < SUB; i += 16) {
+                            __m512 x = _mm512_load_ps(&sc[tt][h][i]);
+                            // masked cells: an exact zero, not exp(-87)
+                            const __mmask16 live = _mm512_cmp_ps_mask(x, _mm512_set1_ps(-INFINITY), _CMP_NEQ_OQ);
+                            const __m512 e = _mm512_maskz_mov_ps(live, exp16(_mm512_sub_ps(x, nmv)));
+                            _mm512_store_ps(&sc[tt][h][i], e);
+                            sum = _mm512_add_ps(sum, e);
+                        }
+                        l[tt][h] += _mm512_reduce_add_ps(sum);
+                    }
+                }
+                // Values, read in the order they are stored.
+                for (int i = 0; i < len; i++) {
+                    const int64_t cell = c + i;
+                    for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+                        const block * vb = (const block *) ((const char *) v->data + cell*v->nb[1] + kvh*v->nb[2] + s*v->nb[3]);
+                        for (int b = 0; b < NB; b++) {
+                            const __m128i * src = (const __m128i *) vb[b].q;
+                            const __m512 lo = _mm512_cvtepi32_ps(_mm512_cvtepi8_epi32(_mm_loadu_si128(src)));
+                            const __m512 hi = _mm512_cvtepi32_ps(_mm512_cvtepi8_epi32(_mm_loadu_si128(src + 1)));
+                            const float dv = h2f(vb[b].d);
+                            for (int64_t g = 0; g < G; g++) {
+                                const int64_t h = kvh*G + g;
+                                for (int tt = 0; tt < nt; tt++) {
+                                    const float wf = sc[tt][h][i];
+                                    if (wf == 0.0f) {
+                                        continue;
+                                    }
+                                    const __m512 w = _mm512_set1_ps(wf*dv);
+                                    float * p = &acc[tt][h][b*32];
+                                    _mm512_store_ps(p, _mm512_fmadd_ps(lo, w, _mm512_load_ps(p)));
+                                    _mm512_store_ps(p + 16, _mm512_fmadd_ps(hi, w, _mm512_load_ps(p + 16)));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
+            for (int tt = 0; tt < nt; tt++) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    float * o = j.out + ((s*n_batch + t0 + tt)*n_head + h)*(D + 2);
+                    std::memcpy(o, acc[tt][h], sizeof(acc[tt][h]));
+                    o[D] = m[tt][h];
+                    o[D + 1] = l[tt][h];
+                }
+            }
+        }
+    }
+    return true;
+}
+
+#else
+
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job &) {
+    return false;
+}
+
+#endif
diff --git a/src/llama-redgiant-attn.cpp b/src/llama-redgiant-attn.cpp
new file mode 100644
index 0000000..ebb2219
--- /dev/null
+++ b/src/llama-redgiant-attn.cpp
@@ -0,0 +1,288 @@
+#include "llama-redgiant-attn.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+#if defined(_MSC_VER)
+#include <intrin.h>
+#elif defined(__x86_64__) || defined(__i386__)
+#include <cpuid.h>
+#endif
+
+// Chunks the cache is split in: each is a stretch of cells read whole by one thread; their partial softmaxes are merged
+// by the second op. Enough to keep 12-24 threads busy with uneven cores.
+static constexpr int64_t RG_CHUNKS = 64;
+static constexpr int64_t RG_D      = 128;
+
+// The chunks used for n_kv cells: about 256 cells each, so a short conversation is not split in 64 tiny pieces that
+// each prepare the queries and clear their sums (measured: 44 against 50 t/s at 439 cells).
+static int64_t rg_chunks_used(int64_t n_kv) {
+    return std::max<int64_t>(1, std::min<int64_t>(RG_CHUNKS, n_kv/256));
+}
+
+static bool rg_has_avx512_vnni() {
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    int r[4];
+    __cpuidex(r, 7, 0);
+    const bool f = (r[1] >> 16) & 1, bw = (r[1] >> 30) & 1, vl = (r[1] >> 31) & 1, vnni = (r[2] >> 11) & 1;
+    return f && bw && vl && vnni;
+#elif defined(__x86_64__) || defined(__i386__)
+    unsigned a, b, c, d;
+    if (!__get_cpuid_count(7, 0, &a, &b, &c, &d)) {
+        return false;
+    }
+    return ((b >> 16) & 1) && ((b >> 30) & 1) && ((b >> 31) & 1) && ((c >> 11) & 1);
+#else
+    return false;
+#endif
+}
+
+static const bool rg_fast = rg_has_avx512_vnni();
+
+static float rg_h2f(ggml_fp16_t h) {
+    return ggml_fp16_to_fp32(h);
+}
+
+struct rg_block {
+    ggml_fp16_t d;
+    int8_t      q[32];
+};
+static_assert(sizeof(rg_block) == 34, "q8_0 block");
+
+// The plain kernel: the same result, one cell at a time, for processors without AVX-512 VNNI.
+static void rg_chunk_plain(const llama_redgiant_attn_job & j) {
+    const ggml_tensor * q = j.q;
+    const ggml_tensor * k = j.k;
+    const ggml_tensor * v = j.v;
+    const ggml_tensor * mask = j.mask;
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    const int64_t n_head_kv = k->ne[2], group = n_head / n_head_kv;
+    std::vector<float> qf(RG_D), acc(RG_D);
+    for (int64_t s = 0; s < ne3; s++) {
+        for (int64_t t = 0; t < n_batch; t++) {
+            for (int64_t h = 0; h < n_head; h++) {
+                const int64_t kvh = h / group;
+                const float * qp = (const float *) ((const char *) q->data + t*q->nb[1] + h*q->nb[2] + s*q->nb[3]);
+                std::fill(acc.begin(), acc.end(), 0.0f);
+                float m = -INFINITY, l = 0.0f;
+                for (int64_t c = j.c0; c < j.c1; c++) {
+                    float mv = 0.0f;
+                    if (mask) {
+                        mv = rg_h2f(*(const ggml_fp16_t *) ((const char *) mask->data + c*mask->nb[0] + t*mask->nb[1] +
+                                                            (h % mask->ne[2])*mask->nb[2] + (s % mask->ne[3])*mask->nb[3]));
+                        if (mv == -INFINITY) {
+                            continue;
+                        }
+                    }
+                    const rg_block * kb = (const rg_block *) ((const char *) k->data + c*k->nb[1] + kvh*k->nb[2] + s*k->nb[3]);
+                    float dot = 0.0f;
+                    for (int b = 0; b < RG_D/32; b++) {
+                        float sb = 0.0f;
+                        for (int i = 0; i < 32; i++) {
+                            sb += kb[b].q[i] * qp[b*32 + i];
+                        }
+                        dot += sb * rg_h2f(kb[b].d);
+                    }
+                    const float x = dot*j.scale + mv;
+                    const float nm = std::max(m, x);
+                    const float r = std::exp(m - nm), w = std::exp(x - nm);
+                    const rg_block * vb = (const rg_block *) ((const char *) v->data + c*v->nb[1] + kvh*v->nb[2] + s*v->nb[3]);
+                    for (int b = 0; b < RG_D/32; b++) {
+                        const float dv = rg_h2f(vb[b].d);
+                        for (int i = 0; i < 32; i++) {
+                            acc[b*32 + i] = acc[b*32 + i]*r + w*dv*vb[b].q[i];
+                        }
+                    }
+                    l = l*r + w;
+                    m = nm;
+                }
+                float * o = j.out + ((s*n_batch + t)*n_head + h)*(RG_D + 2);
+                std::memcpy(o, acc.data(), RG_D*sizeof(float));
+                o[RG_D] = m;
+                o[RG_D + 1] = l;
+            }
+        }
+    }
+}
+
+// First op: the partial result of every chunk. dst: [D+2, n_head, n_batch*ne3, RG_CHUNKS].
+static void rg_chunks_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    float scale;
+    std::memcpy(&scale, &userdata, sizeof(float));
+    const int64_t n_kv = k->ne[1], used = rg_chunks_used(n_kv);
+    for (int64_t c = ith; c < used; c += nth) {
+        llama_redgiant_attn_job job = {q, k, v, mask, scale, n_kv*c/used, n_kv*(c + 1)/used,
+                                       (float *) ((char *) dst->data + c*dst->nb[3])};
+        if (!rg_fast || !llama_redgiant_attn_chunk_avx512(job)) {
+            rg_chunk_plain(job);
+        }
+    }
+}
+
+// Second op: the chunks merged, the sink added to the sum. dst: [D, n_head, n_batch, ne3].
+static void rg_merge_op(ggml_tensor * dst, int ith, int nth, void *) {
+    const ggml_tensor * parts = dst->src[0];
+    const ggml_tensor * sinks = dst->src[1];
+    const int64_t n_head = dst->ne[1], rows = dst->ne[1]*dst->ne[2]*dst->ne[3];
+    const float * pd = (const float *) parts->data;
+    const int64_t stride = rows*(RG_D + 2);
+    const int64_t used = rg_chunks_used(parts->src[1]->ne[1]);
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t h = r % n_head;
+        float m = -INFINITY;
+        for (int64_t c = 0; c < used; c++) {
+            const float * p = pd + c*stride + r*(RG_D + 2);
+            if (p[RG_D + 1] > 0.0f) {
+                m = std::max(m, p[RG_D]);
+            }
+        }
+        const float sink = sinks ? ((const float *) sinks->data)[h] : -INFINITY;
+        m = std::max(m, sink);
+        float * o = (float *) dst->data + r*RG_D;
+        std::fill(o, o + RG_D, 0.0f);
+        if (m == -INFINITY) {
+            continue;
+        }
+        float l = sinks ? std::exp(sink - m) : 0.0f;
+        for (int64_t c = 0; c < used; c++) {
+            const float * p = pd + c*stride + r*(RG_D + 2);
+            if (p[RG_D + 1] <= 0.0f) {
+                continue;
+            }
+            const float w = std::exp(p[RG_D] - m);
+            l += p[RG_D + 1]*w;
+            for (int64_t d = 0; d < RG_D; d++) {
+                o[d] += p[d]*w;
+            }
+        }
+        const float inv = l > 0.0f ? 1.0f/l : 0.0f;
+        for (int64_t d = 0; d < RG_D; d++) {
+            o[d] *= inv;
+        }
+    }
+}
+
+bool llama_redgiant_attn_supported(const ggml_tensor * k, const ggml_tensor * v, float max_bias, float softcap) {
+    return k->type == GGML_TYPE_Q8_0 && v->type == GGML_TYPE_Q8_0 && k->ne[0] == RG_D && v->ne[0] == RG_D &&
+           max_bias == 0.0f && softcap == 0.0f;
+}
+
+ggml_tensor * llama_redgiant_attn_cpu(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * sinks,
+        float scale) {
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    void * ud = nullptr;
+    std::memcpy(&ud, &scale, sizeof(float));
+    ggml_tensor * args[4] = {q, k, v, mask};
+    ggml_tensor * parts = ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D + 2, n_head, n_batch*ne3, RG_CHUNKS, args,
+                                         mask ? 4 : 3, rg_chunks_op, GGML_N_TASKS_MAX, ud);
+    ggml_tensor * margs[2] = {parts, sinks};
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D, n_head, n_batch, ne3, margs, sinks ? 2 : 1, rg_merge_op,
+                          GGML_N_TASKS_MAX, nullptr);
+}
+
+// The merged result of row r (query row x head) over the chunks: sum of weighted values, max score, softmax sum.
+static void rg_merge_row(const ggml_tensor * parts, int64_t r, int64_t rows, float * acc, float & m, float & l) {
+    const float * pd = (const float *) parts->data;
+    const int64_t stride = rows*(RG_D + 2), used = rg_chunks_used(parts->src[1]->ne[1]);
+    m = -INFINITY;
+    for (int64_t c = 0; c < used; c++) {
+        const float * p = pd + c*stride + r*(RG_D + 2);
+        if (p[RG_D + 1] > 0.0f) {
+            m = std::max(m, p[RG_D]);
+        }
+    }
+    l = 0.0f;
+    std::fill(acc, acc + RG_D, 0.0f);
+    if (m == -INFINITY) {
+        return;
+    }
+    for (int64_t c = 0; c < used; c++) {
+        const float * p = pd + c*stride + r*(RG_D + 2);
+        if (p[RG_D + 1] <= 0.0f) {
+            continue;
+        }
+        const float w = std::exp(p[RG_D] - m);
+        l += p[RG_D + 1]*w;
+        for (int64_t d = 0; d < RG_D; d++) {
+            acc[d] += p[d]*w;
+        }
+    }
+}
+
+// The processor's rows of values: dst [n_head_kv*D, group*n_batch], userdata = group.
+static void rg_vrows_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * parts = dst->src[0];
+    const int64_t group = (int64_t) (intptr_t) userdata;
+    const int64_t n_head = parts->ne[1], n_batch = parts->ne[2], rows = n_head*n_batch, n_head_kv = n_head/group;
+    float acc[RG_D];
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t t = r / n_head, h = r % n_head, kvh = h / group, g = h % group;
+        float m, l;
+        rg_merge_row(parts, r, rows, acc, m, l);
+        float * o = (float *) ((char *) dst->data + (t*group + g)*dst->nb[1]) + kvh*RG_D;
+        const float inv = l > 0.0f ? 1.0f/l : 0.0f;
+        for (int64_t d = 0; d < RG_D; d++) {
+            o[d] = acc[d]*inv;
+        }
+        GGML_UNUSED(n_head_kv);
+    }
+}
+
+// The mask of the processor's rows: dst [vpad, n_batch, n_head, 1] F16, userdata = group.
+static void rg_vmask_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * parts = dst->src[0];
+    const int64_t group = (int64_t) (intptr_t) userdata;
+    const int64_t n_head = parts->ne[1], n_batch = parts->ne[2], rows = n_head*n_batch, vpad = dst->ne[0];
+    const ggml_fp16_t ninf = ggml_fp32_to_fp16(-INFINITY);
+    float acc[RG_D];
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t t = r / n_head, h = r % n_head, g = h % group;
+        float m, l;
+        rg_merge_row(parts, r, rows, acc, m, l);
+        ggml_fp16_t * o = (ggml_fp16_t *) ((char *) dst->data + t*dst->nb[1] + h*dst->nb[2]);
+        for (int64_t j = 0; j < vpad; j++) {
+            o[j] = ninf;
+        }
+        if (l > 0.0f) {
+            o[t*group + g] = ggml_fp32_to_fp16(m + std::log(l));
+        }
+    }
+}
+
+llama_redgiant_cold llama_redgiant_attn_cold(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        float scale,
+        int64_t group,
+        int64_t vpad) {
+    GGML_ASSERT(q->ne[3] == 1 && "one stream (--kv-unified)");
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2];
+    void * ud = nullptr;
+    std::memcpy(&ud, &scale, sizeof(float));
+    ggml_tensor * args[4] = {q, k, v, mask};
+    ggml_tensor * parts = ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D + 2, n_head, n_batch, RG_CHUNKS, args,
+                                         mask ? 4 : 3, rg_chunks_op, GGML_N_TASKS_MAX, ud);
+    ggml_tensor * pa[1] = {parts};
+    void * g = (void *) (intptr_t) group;
+    llama_redgiant_cold res;
+    res.vrows = ggml_custom_4d(ctx, GGML_TYPE_F32, (n_head/group)*RG_D, group*n_batch, 1, 1, pa, 1, rg_vrows_op,
+                               GGML_N_TASKS_MAX, g);
+    res.mask = ggml_custom_4d(ctx, GGML_TYPE_F16, vpad, n_batch, n_head, 1, pa, 1, rg_vmask_op, GGML_N_TASKS_MAX, g);
+    return res;
+}
