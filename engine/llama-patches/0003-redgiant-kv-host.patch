+    const uint32_t d = v ? hparams.n_embd_head_v(il) : hparams.n_embd_head_k(il);
+    GGML_ASSERT(n_kv > rg_hot);
+    return ggml_view_4d(ctx, t, d, hparams.n_head_kv(il), n_kv - rg_hot, 1,
+            ggml_row_size(t->type, d), t->nb[1], t->nb[1]*(n_kv - rg_hot), t->nb[1]*rg_hot);
+}
+
+ggml_tensor * llama_kv_cache::rg_cpy_hot(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * idxs, int32_t il, bool v) const {
+    const auto & ly = layers[map_layer_ids.at(il)];
+    ggml_tensor * t = v ? ly.v_hot : ly.k_hot;
+    const int64_t n_embd_gqa = cur->ne[0]*cur->ne[1];
+    GGML_ASSERT(ggml_row_size(cur->type, cur->ne[0]) == cur->nb[1]);
+    cur = ggml_view_2d(ctx, cur, n_embd_gqa, cur->ne[2], cur->nb[2], 0);
+    return ggml_set_rows(ctx, t, cur, idxs);
+}
+
+void llama_kv_cache::rg_set_input_hot_idxs(ggml_tensor * dst, const llama_ubatch * ubatch, const slot_info & sinfo) const {
+    GGML_UNUSED(ubatch);
+    rg_sync();
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst->buffer));
+    int64_t * data = (int64_t *) dst->data;
+    for (uint32_t i = 0; i < sinfo.size(); ++i) {
+        const int64_t idx = sinfo.idxs[0][i];
+        data[i] = idx < (int64_t) rg_hot ? idx : (int64_t) (rg_hot + RG_VIRT);
+    }
+}
+
+void llama_kv_cache::rg_set_input_virt_idxs(ggml_tensor * dst) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst->buffer));
+    int64_t * data = (int64_t *) dst->data;
+    for (int64_t i = 0; i < ggml_nelements(dst); ++i) {
+        data[i] = rg_hot + i;
+    }
+}
+
+void llama_kv_cache::rg_sync() const {
+    if (!rg_dirty || rg_hot == 0) {
+        return;
+    }
+    for (const auto & ly : layers) {
+        if (!ly.k_hot || !ly.k_hot->buffer || !ly.k->buffer) {
+            continue;
+        }
+        ggml_backend_tensor_set(ly.k_hot, ly.k->data, 0, ly.k->nb[1]*rg_hot);
+        ggml_backend_tensor_set(ly.v_hot, ly.v->data, 0, ly.v->nb[1]*rg_hot);
+        // the processor's rows: keys of zero (their score is the mask alone), values of zero until written
+        ggml_backend_tensor_memset(ly.k_hot, 0, ly.k_hot->nb[1]*rg_hot, ly.k_hot->nb[1]*(RG_VIRT + 1));
+        ggml_backend_tensor_memset(ly.v_hot, 0, ly.v_hot->nb[1]*rg_hot, ly.v_hot->nb[1]*(RG_VIRT + 1));
+    }
+    rg_dirty = false;
+}
+
+uint32_t llama_kv_cache_context::rg_hot_cells() const {
+    return kv->rg_hot_cells();
+}
+
+bool llama_kv_cache_context::rg_has_hot(int32_t il) const {
+    return kv->rg_has_hot(il);
+}
+
+ggml_tensor * llama_kv_cache_context::rg_get_hot(ggml_context * ctx, int32_t il, uint32_t rows, bool v) const {
+    return kv->rg_get_hot(ctx, il, rows, v);
+}
+
+ggml_tensor * llama_kv_cache_context::rg_get_cold(ggml_context * ctx, int32_t il, bool v) const {
+    return kv->rg_get_cold(ctx, il, n_kv, v);
+}
+
+ggml_tensor * llama_kv_cache_context::rg_cpy_hot(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * idxs, int32_t il, bool v) const {
+    return kv->rg_cpy_hot(ctx, cur, idxs, il, v);
+}
+
+void llama_kv_cache_context::rg_set_input_hot_idxs(ggml_tensor * dst, const llama_ubatch * ubatch) const {
+    kv->rg_set_input_hot_idxs(dst, ubatch, sinfos[i_cur]);
+}
+
+void llama_kv_cache_context::rg_set_input_virt_idxs(ggml_tensor * dst) const {
+    kv->rg_set_input_virt_idxs(dst);
+}
+
+ggml_tensor * llama_kv_cache::rg_cpy_virt(ggml_context * ctx, ggml_tensor * vrows, ggml_tensor * idxs, int32_t il) const {
+    return ggml_set_rows(ctx, layers[map_layer_ids.at(il)].v_hot, vrows, idxs);
+}
+
+ggml_tensor * llama_kv_cache_context::rg_cpy_virt(ggml_context * ctx, ggml_tensor * vrows, ggml_tensor * idxs, int32_t il) const {
+    return kv->rg_cpy_virt(ctx, vrows, idxs, il);
+}
