index 0000000..965251d
--- /dev/null
+++ b/src/llama-redgiant-attn-avx512.cpp
@@ -0,0 +1,506 @@
+// RedGiant (C.4): the fast kernel of llama-redgiant-attn.cpp, built with AVX-512 and called only when the processor has
+// AVX-512 with VNNI (checked at run time). The C.4.1 prototype (rg-test/c4/proto.cu, cpu_attn2) read the cache at the
+// RAM's speed on a Ryzen 9 9900X (60-67 GB/s): every kv head of a cell together, keys with VNNI (k+128 unsigned times q
+// signed, minus 128 x the sum of q per group of 4 bytes), 16 exps at a time.
+
+#include "llama-redgiant-attn.h"
+
+#if defined(__AVX512F__)
+
+#include <immintrin.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+constexpr int D   = 128;
+constexpr int NB  = D/32;
+constexpr int TG  = 8;   // query rows read together while a message is read: each cell's keys serve them all
+constexpr int SUB = 32;  // cells per scoring step
+constexpr int MAXH = 64;
+
+struct block {
+    uint16_t d;
+    int8_t   q[32];
+};
+
+inline float h2f(uint16_t h) {
+    // F16C, as every compiler spells it (MSVC has no _cvtsh_ss)
+    return _mm_cvtss_f32(_mm_cvtph_ps(_mm_cvtsi32_si128(h)));
+}
+
+inline __m512 exp16(__m512 x) {
+    x = _mm512_max_ps(x, _mm512_set1_ps(-87.f));
+    const __m512 t = _mm512_mul_ps(x, _mm512_set1_ps(1.44269504f));
+    const __m512 n = _mm512_roundscale_ps(t, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
+    const __m512 f = _mm512_sub_ps(t, n);
+    __m512 p = _mm512_set1_ps(1.535336188e-4f);
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(1.339887440e-3f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(9.618437357e-3f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(5.550332471e-2f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(2.402264791e-1f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(6.931472028e-1f));
+    p = _mm512_fmadd_ps(p, f, _mm512_set1_ps(1.f));
+    return _mm512_scalef_ps(p, n);
+}
+
+inline float hsum8(__m256 v) {
+    __m128 a = _mm_add_ps(_mm256_castps256_ps128(v), _mm256_extractf128_ps(v, 1));
+    a = _mm_add_ps(a, _mm_movehl_ps(a, a));
+    a = _mm_add_ss(a, _mm_movehdup_ps(a));
+    return _mm_cvtss_f32(a);
+}
+
+// A Q8_0 or Q4_0 block's 32 values as unsigned bytes for VNNI (+128, or the Q4_0 nibbles as they are: value + 8),
+// and its scale. The offset to take back is 128 x, or 8 x, the sum of the query's values.
+inline __m256i k_unsigned(const char * row, int b, bool q4, float & d) {
+    if (q4) {
+        const char * p = row + b*18;
+        d = h2f(*(const uint16_t *) p);
+        const __m128i qs = _mm_loadu_si128((const __m128i *) (p + 2));
+        const __m128i lo = _mm_and_si128(qs, _mm_set1_epi8(0x0F));
+        const __m128i hi = _mm_and_si128(_mm_srli_epi16(qs, 4), _mm_set1_epi8(0x0F));
+        return _mm256_set_m128i(hi, lo);
+    }
+    const char * p = row + b*34;
+    d = h2f(*(const uint16_t *) p);
+    return _mm256_xor_si256(_mm256_loadu_si256((const __m256i *) (p + 2)), _mm256_set1_epi8((char) 0x80));
+}
+
+// A block's 32 values as floats (scale applied), in two halves.
+inline void v_floats(const char * row, int b, bool q4, __m512 & lo, __m512 & hi) {
+    if (q4) {
+        const char * p = row + b*18;
+        const __m512 d = _mm512_set1_ps(h2f(*(const uint16_t *) p));
+        const __m128i qs = _mm_loadu_si128((const __m128i *) (p + 2));
+        const __m512i eight = _mm512_set1_epi32(8);
+        const __m512i l = _mm512_sub_epi32(_mm512_cvtepu8_epi32(_mm_and_si128(qs, _mm_set1_epi8(0x0F))), eight);
+        const __m512i h = _mm512_sub_epi32(_mm512_cvtepu8_epi32(_mm_and_si128(_mm_srli_epi16(qs, 4), _mm_set1_epi8(0x0F))), eight);
+        lo = _mm512_mul_ps(_mm512_cvtepi32_ps(l), d);
+        hi = _mm512_mul_ps(_mm512_cvtepi32_ps(h), d);
+        return;
+    }
+    const char * p = row + b*34;
+    const __m512 d = _mm512_set1_ps(h2f(*(const uint16_t *) p));
+    const __m128i * src = (const __m128i *) (p + 2);
+    lo = _mm512_mul_ps(_mm512_cvtepi32_ps(_mm512_cvtepi8_epi32(_mm_loadu_si128(src))), d);
+    hi = _mm512_mul_ps(_mm512_cvtepi32_ps(_mm512_cvtepi8_epi32(_mm_loadu_si128(src + 1))), d);
+}
+
+}  // namespace
+
+// The kernel for a message being read (many query rows): for each kv head, blocks of 32 cells like a matrix product.
+// Keys repacked so one VNNI instruction scores a query against 16 cells (no horizontal sums); the mask built once per
+// block for the head's queries; values dequantized once per block and multiplied by the probabilities in tiles of
+// 4 queries x 64 dims kept in registers. Same result as the row kernel (exact softmax, same int8 query).
+static bool rg_chunk_gemm(const llama_redgiant_attn_job & j) {
+    const ggml_tensor * q = j.q;
+    const ggml_tensor * k = j.k;
+    const ggml_tensor * v = j.v;
+    const ggml_tensor * mask = j.mask;
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    const int64_t n_head_kv = k->ne[2], G = n_head/n_head_kv;
+    const int64_t NQ = G*n_batch;  // queries of one kv head: row t, head g -> t*G + g
+    const bool    q4   = k->type == GGML_TYPE_Q4_0;
+    const int32_t koff = q4 ? 8 : 128;
+    constexpr int CB = 32;         // cells per block (two VNNI groups of 16)
+
+    static thread_local std::vector<int8_t>  qi;      // [NQ][D]
+    static thread_local std::vector<int32_t> qsum;    // [NQ][NB] 128 x sum of the block
+    static thread_local std::vector<float>   qd;      // [NQ][NB] scale x attention scale
+    static thread_local std::vector<float>   sc;      // [NQ][CB]
+    static thread_local std::vector<float>   accv;    // [NQ][D]
+    static thread_local std::vector<float>   mv, lv;  // [NQ]
+    alignas(64) static thread_local int32_t kp[2][32][16];  // [group of 16 cells][dword of the key][cell]
+    alignas(64) static thread_local float   dk[2][NB][16];
+    alignas(64) static thread_local float   vf[CB][D];
+    qi.resize(NQ*D + 64); qsum.resize(NQ*NB); qd.resize(NQ*NB); sc.resize(NQ*CB + 16); accv.resize(NQ*D + 16);
+    mv.resize(NQ); lv.resize(NQ);
+    int8_t * QI = (int8_t *) (((uintptr_t) qi.data() + 63) & ~(uintptr_t) 63);
+    float * ACC = (float *) (((uintptr_t) accv.data() + 63) & ~(uintptr_t) 63);
+    float * SC = (float *) (((uintptr_t) sc.data() + 63) & ~(uintptr_t) 63);
+
+    for (int64_t s = 0; s < ne3; s++) {
+        for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+            // the queries of this kv head in int8 per block of 32
+            for (int64_t t = 0; t < n_batch; t++) {
+                for (int64_t g = 0; g < G; g++) {
+                    const int64_t qq = t*G + g, h = kvh*G + g;
+                    const float * qp = (const float *) ((const char *) q->data + t*q->nb[1] + h*q->nb[2] + s*q->nb[3]);
+                    for (int b = 0; b < NB; b++) {
+                        // 32 values at a time: absolute max, scale, round to int8 (no lrint: a CRT call on Windows)
+                        const __m512 x0 = _mm512_loadu_ps(qp + b*32), x1 = _mm512_loadu_ps(qp + b*32 + 16);
+                        const float a = _mm512_reduce_max_ps(_mm512_max_ps(_mm512_abs_ps(x0), _mm512_abs_ps(x1)));
+                        const float d = a/127.0f;
+                        qd[qq*NB + b] = d*j.scale;
+                        const __m512 inv = _mm512_set1_ps(d != 0.0f ? 1.0f/d : 0.0f);
+                        const __m512i i0 = _mm512_cvtps_epi32(_mm512_mul_ps(x0, inv));
+                        const __m512i i1 = _mm512_cvtps_epi32(_mm512_mul_ps(x1, inv));
+                        _mm_storeu_si128((__m128i *) (QI + qq*D + b*32), _mm512_cvtsepi32_epi8(i0));
+                        _mm_storeu_si128((__m128i *) (QI + qq*D + b*32 + 16), _mm512_cvtsepi32_epi8(i1));
+                        qsum[qq*NB + b] = koff*_mm512_reduce_add_epi32(_mm512_add_epi32(i0, i1));
+                    }
+                    mv[qq] = -INFINITY;
+                    lv[qq] = 0.0f;
+                    std::memset(ACC + qq*D, 0, D*sizeof(float));
+                }
+            }
+            for (int64_t c0 = j.c0; c0 < j.c1; c0 += CB) {
+                const int len = (int) std::min<int64_t>(CB, j.c1 - c0);
+                // keys repacked: dword d4 of each cell, 16 cells side by side (unsigned: +128)
+                for (int grp = 0; grp < 2; grp++) {
+                    for (int ci = 0; ci < 16; ci++) {
+                        const int cell = grp*16 + ci;
+                        if (cell < len) {
+                            const char * kr = (const char *) k->data + (c0 + cell)*k->nb[1] + kvh*k->nb[2] + s*k->nb[3];
+                            for (int b = 0; b < NB; b++) {
+                                alignas(32) uint32_t w[8];
+                                _mm256_store_si256((__m256i *) w, k_unsigned(kr, b, q4, dk[grp][b][ci]));
+                                for (int x = 0; x < 8; x++) {
+                                    kp[grp][b*8 + x][ci] = (int32_t) w[x];
+                                }
+                            }
+                        } else {
+                            for (int b = 0; b < NB; b++) {
+                                dk[grp][b][ci] = 0.0f;
+                                for (int x = 0; x < 8; x++) kp[grp][b*8 + x][ci] = 0;
+                            }
+                        }
+                    }
+                }
+                // scores of every query against the 32 cells
+                for (int64_t qq = 0; qq < NQ; qq++) {
+                    const int8_t * qrow = QI + qq*D;
+                    for (int grp = 0; grp < 2; grp++) {
+                        __m512 f = _mm512_setzero_ps();
+                        for (int b = 0; b < NB; b++) {
+                            __m512i acc = _mm512_setzero_si512();
+                            for (int x = 0; x < 8; x++) {
+                                int32_t qw;
+                                std::memcpy(&qw, qrow + b*32 + x*4, 4);
+                                acc = _mm512_dpbusd_epi32(acc, _mm512_load_si512((const void *) kp[grp][b*8 + x]), _mm512_set1_epi32(qw));
+                            }
+                            acc = _mm512_sub_epi32(acc, _mm512_set1_epi32(qsum[qq*NB + b]));
+                            f = _mm512_fmadd_ps(_mm512_cvtepi32_ps(acc),
+                                                _mm512_mul_ps(_mm512_load_ps(dk[grp][b]), _mm512_set1_ps(qd[qq*NB + b])), f);
+                        }
+                        _mm512_store_ps(SC + qq*CB + grp*16, f);
+                    }
+                }
+                // the mask, once per cell, row and head of this group
+                if (mask || j.raw) {
+                    for (int64_t t = 0; t < n_batch; t++) {
+                        for (int ci = 0; ci < len; ci++) {
+                            const int64_t cell = c0 + ci;
+                            if (mask) {
+                                for (int64_t g = 0; g < G; g++) {
+                                    const int64_t h = kvh*G + g;
+                                    SC[(t*G + g)*CB + ci] += h2f(*(const uint16_t *) ((const char *) mask->data + cell*mask->nb[0] +
+                                                                  t*mask->nb[1] + (h % mask->ne[2])*mask->nb[2] + (s % mask->ne[3])*mask->nb[3]));
+                                }
+                                continue;
+                            }
+                            const char * rp = (const char *) j.raw->data + cell*j.raw->nb[0] + t*j.raw->nb[1];
+                            const float r = j.raw->type == GGML_TYPE_F16 ? h2f(*(const uint16_t *) rp) : *(const float *) rp;
+                            if (r == -INFINITY) {
+                                for (int64_t g = 0; g < G; g++) SC[(t*G + g)*CB + ci] = -INFINITY;
+                                continue;
+                            }
+                            const int32_t dd = *(const int32_t *) ((const char *) j.relpos->data + cell*j.relpos->nb[0] + t*j.relpos->nb[1]);
+                            const char * row = (const char *) j.table->data + dd*j.table->nb[1] + t*j.table->nb[2];
+                            for (int64_t g = 0; g < G; g++) {
+                                SC[(t*G + g)*CB + ci] += r + *(const float *) (row + (kvh*G + g)*j.table->nb[0]);
+                            }
+                        }
+                    }
+                }
+                // softmax by query: new max, rescale the sums, probabilities (exact zero where masked or padding)
+                const __mmask16 pad0 = len >= 16 ? (__mmask16) 0xFFFF : (__mmask16) ((1u << len) - 1);
+                const __mmask16 pad1 = len >= 32 ? (__mmask16) 0xFFFF : len <= 16 ? (__mmask16) 0 : (__mmask16) ((1u << (len - 16)) - 1);
+                for (int64_t qq = 0; qq < NQ; qq++) {
+                    float * srow = SC + qq*CB;
+                    __m512 s0 = _mm512_mask_mov_ps(_mm512_set1_ps(-INFINITY), pad0, _mm512_load_ps(srow));
+                    __m512 s1 = _mm512_mask_mov_ps(_mm512_set1_ps(-INFINITY), pad1, _mm512_load_ps(srow + 16));
+                    const float nm = std::max(mv[qq], _mm512_reduce_max_ps(_mm512_max_ps(s0, s1)));
+                    if (nm == -INFINITY) {
+                        _mm512_store_ps(srow, _mm512_setzero_ps());
+                        _mm512_store_ps(srow + 16, _mm512_setzero_ps());
+                        continue;
+                    }
+                    const float r = std::exp(mv[qq] - nm);
+                    if (r != 1.0f) {
+                        const __m512 rv = _mm512_set1_ps(r);
+                        float * a = ACC + qq*D;
+                        for (int d = 0; d < D; d += 16) _mm512_store_ps(a + d, _mm512_mul_ps(_mm512_load_ps(a + d), rv));
+                        lv[qq] *= r;
+                    }
+                    mv[qq] = nm;
+                    const __m512 nmv = _mm512_set1_ps(nm), ninf = _mm512_set1_ps(-INFINITY);
+                    const __m512 e0 = _mm512_maskz_mov_ps(_mm512_cmp_ps_mask(s0, ninf, _CMP_NEQ_OQ), exp16(_mm512_sub_ps(s0, nmv)));
+                    const __m512 e1 = _mm512_maskz_mov_ps(_mm512_cmp_ps_mask(s1, ninf, _CMP_NEQ_OQ), exp16(_mm512_sub_ps(s1, nmv)));
+                    _mm512_store_ps(srow, e0);
+                    _mm512_store_ps(srow + 16, e1);
+                    lv[qq] += _mm512_reduce_add_ps(_mm512_add_ps(e0, e1));
+                }
+                // values of the block in floats, once
+                for (int ci = 0; ci < CB; ci++) {
+                    if (ci >= len) {
+                        for (int d = 0; d < D; d += 16) _mm512_store_ps(&vf[ci][d], _mm512_setzero_ps());
+                        continue;
+                    }
+                    const char * vr = (const char *) v->data + (c0 + ci)*v->nb[1] + kvh*v->nb[2] + s*v->nb[3];
+                    for (int b = 0; b < NB; b++) {
+                        __m512 lo, hi;
+                        v_floats(vr, b, q4, lo, hi);
+                        _mm512_store_ps(&vf[ci][b*32], lo);
+                        _mm512_store_ps(&vf[ci][b*32 + 16], hi);
+                    }
+                }
+                // sums += probabilities x values, tiles of 4 queries x 64 dims in registers
+                for (int64_t q0 = 0; q0 < NQ; q0 += 4) {
+                    const int nq = (int) std::min<int64_t>(4, NQ - q0);
+                    for (int d0 = 0; d0 < D; d0 += 64) {
+                        __m512 a[4][4];
+                        for (int x = 0; x < 4; x++)
+                            for (int y = 0; y < 4; y++)
+                                a[x][y] = x < nq ? _mm512_load_ps(ACC + (q0 + x)*D + d0 + y*16) : _mm512_setzero_ps();
+                        for (int ci = 0; ci < len; ci++) {
+                            const __m512 v0 = _mm512_load_ps(&vf[ci][d0]), v1 = _mm512_load_ps(&vf[ci][d0 + 16]);
+                            const __m512 v2 = _mm512_load_ps(&vf[ci][d0 + 32]), v3 = _mm512_load_ps(&vf[ci][d0 + 48]);
+                            for (int x = 0; x < 4; x++) {
+                                const __m512 p = _mm512_set1_ps(x < nq ? SC[(q0 + x)*CB + ci] : 0.0f);
+                                a[x][0] = _mm512_fmadd_ps(p, v0, a[x][0]);
+                                a[x][1] = _mm512_fmadd_ps(p, v1, a[x][1]);
+                                a[x][2] = _mm512_fmadd_ps(p, v2, a[x][2]);
+                                a[x][3] = _mm512_fmadd_ps(p, v3, a[x][3]);
+                            }
+                        }
+                        for (int x = 0; x < nq; x++)
+                            for (int y = 0; y < 4; y++) _mm512_store_ps(ACC + (q0 + x)*D + d0 + y*16, a[x][y]);
+                    }
+                }
+            }
+            // the partial results of this kv head's queries
+            for (int64_t t = 0; t < n_batch; t++) {
+                for (int64_t g = 0; g < G; g++) {
+                    const int64_t qq = t*G + g, h = kvh*G + g;
+                    float * o = j.out + ((s*n_batch + t)*n_head + h)*(D + 2);
+                    std::memcpy(o, ACC + qq*D, D*sizeof(float));
+                    o[D] = mv[qq];
+                    o[D + 1] = lv[qq];
+                }
+            }
+        }
+    }
+    return true;
+}
+
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job & j) {
+    const ggml_tensor * q = j.q;
+    const ggml_tensor * k = j.k;
+    const ggml_tensor * v = j.v;
+    const ggml_tensor * mask = j.mask;
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    const int64_t n_head_kv = k->ne[2], G = n_head/n_head_kv;
+    if (n_head > MAXH || k->ne[0] != D) {
+        return false;
+    }
+    // reading a message: many query rows, the matrix kernel
+    if (n_batch >= 4) {
+        return rg_chunk_gemm(j);
+    }
+    const bool    q4   = k->type == GGML_TYPE_Q4_0;
+    const int32_t koff = q4 ? 8 : 128;
+
+    alignas(64) static thread_local int8_t  qi[TG][MAXH][D];
+    alignas(64) static thread_local int32_t corr[TG][MAXH][NB][8];
+    alignas(64) static thread_local float   qd[TG][MAXH][NB];
+    alignas(64) static thread_local float   sc[TG][MAXH][SUB];
+    // [head][row][dim]: the rows of a head side by side (as [row][head][dim] they were 32 KB apart, one cache set)
+    alignas(64) static thread_local float   acc[MAXH][TG][D];
+    static thread_local float m[TG][MAXH], l[TG][MAXH];
+
+
+    for (int64_t s = 0; s < ne3; s++) {
+        for (int64_t t0 = 0; t0 < n_batch; t0 += TG) {
+            const int nt = (int) std::min<int64_t>(TG, n_batch - t0);
+            // The queries of these rows in int8 per block of 32, with their scale and the VNNI correction.
+            for (int tt = 0; tt < nt; tt++) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    const float * qp = (const float *) ((const char *) q->data + (t0 + tt)*q->nb[1] + h*q->nb[2] + s*q->nb[3]);
+                    for (int b = 0; b < NB; b++) {
+                        // 32 values at a time (no lrint: a CRT call on Windows, ~2 ms a token over 8 layers)
+                        const __m512 x0 = _mm512_loadu_ps(qp + b*32), x1 = _mm512_loadu_ps(qp + b*32 + 16);
+                        const float a = _mm512_reduce_max_ps(_mm512_max_ps(_mm512_abs_ps(x0), _mm512_abs_ps(x1)));
+                        const float d = a/127.0f;
+                        qd[tt][h][b] = d*j.scale;
+                        const __m512 inv = _mm512_set1_ps(d != 0.0f ? 1.0f/d : 0.0f);
+                        _mm_store_si128((__m128i *) &qi[tt][h][b*32], _mm512_cvtsepi32_epi8(_mm512_cvtps_epi32(_mm512_mul_ps(x0, inv))));
+                        _mm_store_si128((__m128i *) &qi[tt][h][b*32 + 16], _mm512_cvtsepi32_epi8(_mm512_cvtps_epi32(_mm512_mul_ps(x1, inv))));
+                        for (int g = 0; g < 8; g++) {
+                            int c = 0;
+                            for (int i = 0; i < 4; i++) {
+                                c += qi[tt][h][b*32 + g*4 + i];
+                            }
+                            corr[tt][h][b][g] = koff*c;
+                        }
+                    }
+                    m[tt][h] = -INFINITY;
+                    l[tt][h] = 0.0f;
+                    std::memset(acc[h][tt], 0, sizeof(acc[h][tt]));
+                }
+            }
+
+            for (int64_t c = j.c0; c < j.c1; c += SUB) {
+                const int len = (int) std::min<int64_t>(SUB, j.c1 - c);
+                // Scores: each cell's keys read once, every kv head, for every query row and head.
+                for (int i = 0; i < len; i++) {
+                    const int64_t cell = c + i;
+                    for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+                        const char * kr = (const char *) k->data + cell*k->nb[1] + kvh*k->nb[2] + s*k->nb[3];
+                        __m256i ku[NB];
+                        float   dk[NB];
+                        for (int b = 0; b < NB; b++) {
+                            ku[b] = k_unsigned(kr, b, q4, dk[b]);
+                        }
+                        for (int64_t g = 0; g < G; g++) {
+                            const int64_t h = kvh*G + g;
+                            for (int tt = 0; tt < nt; tt++) {
+                                __m256 f = _mm256_setzero_ps();
+                                for (int b = 0; b < NB; b++) {
+                                    __m256i dot = _mm256_dpbusd_epi32(_mm256_setzero_si256(), ku[b],
+                                                                      _mm256_load_si256((const __m256i *) &qi[tt][h][b*32]));
+                                    dot = _mm256_sub_epi32(dot, _mm256_load_si256((const __m256i *) corr[tt][h][b]));
+                                    f = _mm256_fmadd_ps(_mm256_cvtepi32_ps(dot), _mm256_set1_ps(dk[b]*qd[tt][h][b]), f);
+                                }
+                                sc[tt][h][i] = hsum8(f);
+                            }
+                        }
+                    }
+                }
+                // The mask, once per cell and row: from the bias table every head's value is one row of n_head floats
+                // (the input mask and the distance read once, not once per head).
+                if (mask || j.raw) {
+                    for (int tt = 0; tt < nt; tt++) {
+                        const int64_t t = t0 + tt;
+                        for (int i = 0; i < len; i++) {
+                            const int64_t cell = c + i;
+                            if (mask) {
+                                for (int64_t h = 0; h < n_head; h++) {
+                                    sc[tt][h][i] += h2f(*(const uint16_t *) ((const char *) mask->data + cell*mask->nb[0] +
+                                                                             t*mask->nb[1] + (h % mask->ne[2])*mask->nb[2] +
+                                                                             (s % mask->ne[3])*mask->nb[3]));
+                                }
+                                continue;
+                            }
+                            const char * rp = (const char *) j.raw->data + cell*j.raw->nb[0] + t*j.raw->nb[1];
+                            const float r = j.raw->type == GGML_TYPE_F16 ? h2f(*(const uint16_t *) rp) : *(const float *) rp;
+                            if (r == -INFINITY) {
+                                for (int64_t h = 0; h < n_head; h++) {
+                                    sc[tt][h][i] = -INFINITY;
+                                }
+                                continue;
+                            }
+                            const int32_t d = *(const int32_t *) ((const char *) j.relpos->data + cell*j.relpos->nb[0] + t*j.relpos->nb[1]);
+                            const char * row = (const char *) j.table->data + d*j.table->nb[1] + t*j.table->nb[2];
+                            for (int64_t h = 0; h < n_head; h++) {
+                                sc[tt][h][i] += r + *(const float *) (row + h*j.table->nb[0]);
+                            }
+                        }
+                    }
+                }
+                for (int tt = 0; tt < nt; tt++) {
+                    for (int64_t h = 0; h < n_head; h++) {
+                        for (int i = len; i < SUB; i++) {
+                            sc[tt][h][i] = -INFINITY;
+                        }
+                    }
+                }
+                // Softmax by row and head: new max, rescale, 16 exps at a time.
+                for (int tt = 0; tt < nt; tt++) {
+                    for (int64_t h = 0; h < n_head; h++) {
+                        __m512 mx = _mm512_set1_ps(m[tt][h]);
+                        for (int i = 0; i < SUB; i += 16) {
+                            mx = _mm512_max_ps(mx, _mm512_load_ps(&sc[tt][h][i]));
+                        }
+                        const float nm = _mm512_reduce_max_ps(mx);
+                        if (nm == -INFINITY) {
+                            // every cell masked so far: nothing to add
+                            for (int i = 0; i < SUB; i++) {
+                                sc[tt][h][i] = 0.0f;
+                            }
+                            continue;
+                        }
+                        const float r = std::exp(m[tt][h] - nm);
+                        if (r != 1.0f) {
+                            const __m512 rv = _mm512_set1_ps(r);
+                            for (int d = 0; d < D; d += 16) {
+                                _mm512_store_ps(&acc[h][tt][d], _mm512_mul_ps(_mm512_load_ps(&acc[h][tt][d]), rv));
+                            }
+                        }
+                        l[tt][h] *= r;
+                        m[tt][h] = nm;
+                        __m512 sum = _mm512_setzero_ps();
+                        const __m512 nmv = _mm512_set1_ps(nm);
+                        for (int i = 0; i < SUB; i += 16) {
+                            __m512 x = _mm512_load_ps(&sc[tt][h][i]);
+                            // masked cells: an exact zero, not exp(-87)
+                            const __mmask16 live = _mm512_cmp_ps_mask(x, _mm512_set1_ps(-INFINITY), _CMP_NEQ_OQ);
+                            const __m512 e = _mm512_maskz_mov_ps(live, exp16(_mm512_sub_ps(x, nmv)));
+                            _mm512_store_ps(&sc[tt][h][i], e);
+                            sum = _mm512_add_ps(sum, e);
+                        }
+                        l[tt][h] += _mm512_reduce_add_ps(sum);
+                    }
+                }
+                // Values, read in the order they are stored.
+                for (int i = 0; i < len; i++) {
+                    const int64_t cell = c + i;
+                    for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+                        const char * vr = (const char *) v->data + cell*v->nb[1] + kvh*v->nb[2] + s*v->nb[3];
+                        for (int b = 0; b < NB; b++) {
+                            __m512 lo, hi;
+                            v_floats(vr, b, q4, lo, hi);  // scale applied
+                            const float dv = 1.0f;
+                            for (int64_t g = 0; g < G; g++) {
+                                const int64_t h = kvh*G + g;
+                                for (int tt = 0; tt < nt; tt++) {
+                                    const float wf = sc[tt][h][i];
+                                    if (wf == 0.0f) {
+                                        continue;
+                                    }
+                                    const __m512 w = _mm512_set1_ps(wf*dv);
+                                    float * p = &acc[h][tt][b*32];
+                                    _mm512_store_ps(p, _mm512_fmadd_ps(lo, w, _mm512_load_ps(p)));
+                                    _mm512_store_ps(p + 16, _mm512_fmadd_ps(hi, w, _mm512_load_ps(p + 16)));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
+            for (int tt = 0; tt < nt; tt++) {
+                for (int64_t h = 0; h < n_head; h++) {
+                    float * o = j.out + ((s*n_batch + t0 + tt)*n_head + h)*(D + 2);
+                    std::memcpy(o, acc[h][tt], sizeof(acc[h][tt]));
+                    o[D] = m[tt][h];
+                    o[D + 1] = l[tt][h];
+                }
+            }
+        }
+    }
+    return true;
+}
+
+#else
+
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job &) {
+    return false;
+}
+
+#endif
