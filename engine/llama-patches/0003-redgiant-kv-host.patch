new file mode 100644
index 0000000..341b840
--- /dev/null
+++ b/src/llama-redgiant-attn.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// RedGiant (C.4, plan_contesto.md): attention over a key/value cache kept in RAM, computed by the processor with the
+// cache read once and in the order it is stored (every kv head of a cell together), split in chunks across the threads
+// and merged exactly. Used for the full-context layers when LLAMA_KV_FULL_HOST=2, in place of ggml's CPU flash
+// attention, which reads the same cache once per query head and row by row (~8 GB/s on a Ryzen 9 9900X, 60 here).
+
+#include "ggml.h"
+
+// Same inputs and result as ggml_flash_attn_ext with sinks:
+//   q:     [D, n_batch, n_head, ne3] F32
+//   k, v:  [D, n_kv, n_head_kv, ne3] Q8_0 (D = 128)
+//   mask:  [n_kv, n_batch_pad, ne32, ne33] F16 (per head or broadcast), may be null
+//   sinks: [n_head] F32, may be null
+//   res:   [D, n_head, n_batch, ne3] F32
+ggml_tensor * llama_redgiant_attn_cpu(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * sinks,
+        float scale);
+
+// The cold part for the card's attention (C.4 tappa C): the processor attends to the cells in RAM and hands its result
+// to the card as rows of its own. For query row t and head h = kvh*group + g: row t*group + g of `vrows` holds, at kv
+// head kvh, the processor's normalized result for head h; the mask gives that row, for head h only, the log of the
+// processor's softmax sum (-inf for every other head and row). Keys of zero on those rows: the score is the mask alone,
+// and the card's softmax over its cells plus these rows is the softmax over every cell.
+//   vrows: [n_head_kv*D, group*n_batch] F32
+//   mask:  [vpad, n_batch, n_head, 1] F16
+struct llama_redgiant_cold {
+    ggml_tensor * vrows;
+    ggml_tensor * mask;
+};
+llama_redgiant_cold llama_redgiant_attn_cold(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        float scale,
+        int64_t group,
+        int64_t vpad);
+
+// Whether this attention can take it: Q8_0 keys and values of 128, no softcap or ALiBi.
+bool llama_redgiant_attn_supported(const ggml_tensor * k, const ggml_tensor * v, float max_bias, float softcap);
+
+// The fast kernel (llama-redgiant-attn-avx512.cpp): true when it ran (AVX-512 with VNNI on this processor).
+struct llama_redgiant_attn_job {
+    const ggml_tensor * q;
+    const ggml_tensor * k;
+    const ggml_tensor * v;
+    const ggml_tensor * mask;
+    float scale;
+    int64_t c0, c1;   // cells of this chunk
+    float * out;      // [n_tokens*ne3][n_head][D+2]: acc, m, l
+};
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job & job);
