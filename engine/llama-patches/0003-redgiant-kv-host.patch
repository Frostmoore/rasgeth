+
+ggml_tensor * llama_kv_cache_context::rg_cpy_virt(ggml_context * ctx, ggml_tensor * vrows, ggml_tensor * idxs, int32_t il) const {
+    return kv->rg_cpy_virt(ctx, vrows, idxs, il);
