new file mode 100644
index 0000000..912ab89
--- /dev/null
+++ b/src/llama-redgiant-attn.h
@@ -0,0 +1,106 @@
+#pragma once
+
+// RedGiant (C.4, plan_contesto.md): attention over a key/value cache kept in RAM, computed by the processor with the
+// cache read once and in the order it is stored (every kv head of a cell together), split in chunks across the threads
+// and merged exactly. Used for the full-context layers when LLAMA_KV_FULL_HOST=2, in place of ggml's CPU flash
+// attention, which reads the same cache once per query head and row by row (~8 GB/s on a Ryzen 9 9900X, 60 here).
+
+#include "ggml.h"
+
+#include <cmath>
+#include <cstdint>
+
+// Same inputs and result as ggml_flash_attn_ext with sinks:
+//   q:     [D, n_batch, n_head, ne3] F32
+//   k, v:  [D, n_kv, n_head_kv, ne3] Q8_0 (D = 128)
+//   mask:  [n_kv, n_batch_pad, ne32, ne33] F16 (per head or broadcast), may be null
+//   sinks: [n_head] F32, may be null
+//   res:   [D, n_head, n_batch, ne3] F32
+ggml_tensor * llama_redgiant_attn_cpu(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * sinks,
+        float scale);
+
+// The cold part for the card's attention (C.4 tappa C): the processor attends to the cells in RAM and hands its result
+// to the card as rows of its own. For query row t and head h = kvh*group + g: row t*group + g of `vrows` holds, at kv
+// head kvh, the processor's normalized result for head h; the mask gives that row, for head h only, the log of the
+// processor's softmax sum (-inf for every other head and row). Keys of zero on those rows: the score is the mask alone,
+// and the card's softmax over its cells plus these rows is the softmax over every cell.
+//   vrows: [n_head_kv*D, group*n_batch] F32
+//   mask:  [vpad, n_batch, n_head, 1] F16
+struct llama_redgiant_cold {
+    ggml_tensor * vrows;
+    ggml_tensor * mask;
+};
+// The mask either whole (`mask`, F16 per head) or, for a relative bias, from its parts read cell by cell: the input
+// mask `raw` [n_kv, n_batch] (F32 or F16), the distances `relpos` [n_kv, n_batch] I32 and the bias table `table`
+// [n_head, bins, n_batch] F32 (value = raw + table[h, relpos, t]): nothing of n_kv x n_batch x n_head is ever built.
+llama_redgiant_cold llama_redgiant_attn_cold(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * raw,
+        ggml_tensor * relpos,
+        ggml_tensor * table,
+        float scale,
+        int64_t group,
+        int64_t vpad);
+
+// Whether this attention can take it: Q8_0 keys and values of 128, no softcap or ALiBi.
+bool llama_redgiant_attn_supported(const ggml_tensor * k, const ggml_tensor * v, float max_bias, float softcap);
+
+// The fast kernel (llama-redgiant-attn-avx512.cpp): true when it ran (AVX-512 with VNNI on this processor).
+struct llama_redgiant_attn_job {
+    const ggml_tensor * q;
+    const ggml_tensor * k;
+    const ggml_tensor * v;
+    const ggml_tensor * mask;
+    const ggml_tensor * raw;     // with relpos and table: the mask from its parts
+    const ggml_tensor * relpos;
+    const ggml_tensor * table;
+    float scale;
+    int64_t c0, c1;   // cells of this chunk
+    float * out;      // [n_tokens*ne3][n_head][D+2]: acc, m, l
+};
+bool llama_redgiant_attn_chunk_avx512(const llama_redgiant_attn_job & job);
+
+// One block of 32 values of a Q8_0 or Q4_0 cache row (C.4: the cold part at 4 bits reads half the bytes): its scale,
+// and the values as int8 (-128..127, or -8..7 for Q4_0).
+inline float llama_redgiant_block(const char * row, int b, bool q4, int8_t out[32]) {
+    if (q4) {
+        const char * p = row + b*18;  // block_q4_0: fp16 scale, 16 bytes: low nibbles values 0-15, high 16-31
+        for (int i = 0; i < 16; i++) {
+            const uint8_t x = (uint8_t) p[2 + i];
+            out[i]      = (int8_t) ((x & 0x0F) - 8);
+            out[i + 16] = (int8_t) ((x >> 4) - 8);
+        }
+        return ggml_fp16_to_fp32(*(const ggml_fp16_t *) p);
+    }
+    const char * p = row + b*34;  // block_q8_0: fp16 scale, 32 int8
+    for (int i = 0; i < 32; i++) out[i] = (int8_t) p[2 + i];
+    return ggml_fp16_to_fp32(*(const ggml_fp16_t *) p);
+}
+
+// The mask's value for a cell, a query row and a head: whole, from its parts, or none (0).
+inline float llama_redgiant_mask_at(const llama_redgiant_attn_job & j, int64_t c, int64_t t, int64_t h, int64_t s) {
+    if (j.mask) {
+        return ggml_fp16_to_fp32(*(const ggml_fp16_t *) ((const char *) j.mask->data + c*j.mask->nb[0] + t*j.mask->nb[1] +
+                                                         (h % j.mask->ne[2])*j.mask->nb[2] + (s % j.mask->ne[3])*j.mask->nb[3]));
+    }
+    if (j.raw) {
+        const char * rp = (const char *) j.raw->data + c*j.raw->nb[0] + t*j.raw->nb[1];
+        const float r = j.raw->type == GGML_TYPE_F16 ? ggml_fp16_to_fp32(*(const ggml_fp16_t *) rp) : *(const float *) rp;
+        if (r == -INFINITY) {
+            return r;
+        }
+        const int32_t d = *(const int32_t *) ((const char *) j.relpos->data + c*j.relpos->nb[0] + t*j.relpos->nb[1]);
+        return r + *(const float *) ((const char *) j.table->data + h*j.table->nb[0] + d*j.table->nb[1] + t*j.table->nb[2]);
+    }
+    return 0.0f;
+}
