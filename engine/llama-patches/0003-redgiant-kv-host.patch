+
+// Chunks the cache is split in: each is a stretch of cells read whole by one thread; their partial softmaxes are merged
+// by the second op. Enough to keep 12-24 threads busy with uneven cores.
+static constexpr int64_t RG_CHUNKS = 64;
+static constexpr int64_t RG_D      = 128;
+static constexpr int64_t RG_PAGE   = 64;  // cells per page of the selective reading
+
+// The chunks used for n_kv cells: about 256 cells each, so a short conversation is not split in 64 tiny pieces that
+// each prepare the queries and clear their sums (measured: 44 against 50 t/s at 439 cells).
+// With many query rows (a message being read) each cell is much work: fewer, longer chunks keep the threads busy and
+// the partial results small (64 chunks x 1536 rows x 130 floats was 51 MB written and read back twice per layer).
+static int64_t rg_chunks_used(int64_t n_kv, int64_t rows) {
+    if (rows >= 4) {
+        return std::max<int64_t>(1, std::min<int64_t>(24, n_kv/512));
+    }
+    return std::max<int64_t>(1, std::min<int64_t>(RG_CHUNKS, n_kv/256));
+}
+
+static bool rg_has_avx512_vnni() {
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))
+    int r[4];
+    __cpuidex(r, 7, 0);
+    const bool f = (r[1] >> 16) & 1, bw = (r[1] >> 30) & 1, vl = (r[1] >> 31) & 1, vnni = (r[2] >> 11) & 1;
+    return f && bw && vl && vnni;
+#elif defined(__x86_64__) || defined(__i386__)
+    unsigned a, b, c, d;
+    if (!__get_cpuid_count(7, 0, &a, &b, &c, &d)) {
+        return false;
+    }
+    return ((b >> 16) & 1) && ((b >> 30) & 1) && ((b >> 31) & 1) && ((c >> 11) & 1);
+#else
+    return false;
+#endif
+}
+
+static const bool rg_fast = rg_has_avx512_vnni();
+
+// The plain kernel: the same result, one cell at a time, for processors without AVX-512 VNNI.
+static void rg_chunk_plain(const llama_redgiant_attn_job & j) {
+    const ggml_tensor * q = j.q;
+    const ggml_tensor * k = j.k;
+    const ggml_tensor * v = j.v;
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    const int64_t n_head_kv = k->ne[2], group = n_head / n_head_kv;
+    const bool q4 = k->type == GGML_TYPE_Q4_0;
+    std::vector<float> qf(RG_D), acc(RG_D);
+    for (int64_t s = 0; s < ne3; s++) {
+        for (int64_t t = 0; t < n_batch; t++) {
+            for (int64_t h = 0; h < n_head; h++) {
+                const int64_t kvh = h / group;
+                const float * qp = (const float *) ((const char *) q->data + t*q->nb[1] + h*q->nb[2] + s*q->nb[3]);
+                std::fill(acc.begin(), acc.end(), 0.0f);
+                float m = -INFINITY, l = 0.0f;
+                for (int64_t c = j.c0; c < j.c1; c++) {
+                    const float mv = llama_redgiant_mask_at(j, c, t, h, s);
+                    if (mv == -INFINITY) {
+                        continue;
+                    }
+                    const char * kr = (const char *) k->data + c*k->nb[1] + kvh*k->nb[2] + s*k->nb[3];
+                    float dot = 0.0f;
+                    int8_t x8[32];
+                    for (int b = 0; b < RG_D/32; b++) {
+                        const float dk = llama_redgiant_block(kr, b, q4, x8);
+                        float sb = 0.0f;
+                        for (int i = 0; i < 32; i++) {
+                            sb += x8[i] * qp[b*32 + i];
+                        }
+                        dot += sb * dk;
+                    }
+                    const float x = dot*j.scale + mv;
+                    const float nm = std::max(m, x);
+                    const float r = std::exp(m - nm), w = std::exp(x - nm);
+                    const char * vr = (const char *) v->data + c*v->nb[1] + kvh*v->nb[2] + s*v->nb[3];
+                    for (int b = 0; b < RG_D/32; b++) {
+                        const float dv = llama_redgiant_block(vr, b, q4, x8);
+                        for (int i = 0; i < 32; i++) {
+                            acc[b*32 + i] = acc[b*32 + i]*r + w*dv*x8[i];
+                        }
+                    }
+                    l = l*r + w;
+                    m = nm;
+                }
+                float * o = j.out + ((s*n_batch + t)*n_head + h)*(RG_D + 2);
+                std::memcpy(o, acc.data(), RG_D*sizeof(float));
+                o[RG_D] = m;
+                o[RG_D + 1] = l;
+            }
+        }
+    }
+}
+
+// First op: the partial result of every chunk. dst: [D+2, n_head, n_batch*ne3, RG_CHUNKS].
+static void rg_chunks_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * v = dst->src[2];
+    // src[3]: the mask whole, or (with src[4], src[5]) the input mask, the distances and the bias table
+    const ggml_tensor * mask   = dst->src[4] ? nullptr : dst->src[3];
+    const ggml_tensor * raw    = dst->src[4] ? dst->src[3] : nullptr;
+    const ggml_tensor * relpos = dst->src[4];
+    const ggml_tensor * table  = dst->src[5];
+    float scale;
+    std::memcpy(&scale, &userdata, sizeof(float));
+    const int64_t n_kv = k->ne[1], used = rg_chunks_used(n_kv, q->ne[1]*q->ne[3]);
+    // selective reading (LLAMA_KV_SELECT): one chunk per chosen page of 64 cells, the others empty
+    const ggml_tensor * list = dst->src[6];
+    if (list) {
+        const int32_t * pages = (const int32_t *) list->data;
+        const int64_t rows = q->ne[2]*q->ne[1]*q->ne[3];
+        for (int64_t c = ith; c < RG_CHUNKS; c += nth) {
+            float * out = (float *) ((char *) dst->data + c*dst->nb[3]);
+            if (c >= list->ne[0] || pages[c] < 0) {
+                for (int64_t r = 0; r < rows; r++) {
+                    out[r*(RG_D + 2) + RG_D] = -INFINITY;
+                    out[r*(RG_D + 2) + RG_D + 1] = 0.0f;
+                }
+                continue;
+            }
+            const int64_t c0 = (int64_t) pages[c]*RG_PAGE, c1 = std::min(n_kv, c0 + RG_PAGE);
+            llama_redgiant_attn_job job = {q, k, v, mask, raw, relpos, table, scale, c0, c1, out};
+            if (!rg_fast || !llama_redgiant_attn_chunk_avx512(job)) {
+                rg_chunk_plain(job);
+            }
+        }
+        return;
+    }
+    for (int64_t c = ith; c < used; c += nth) {
+        llama_redgiant_attn_job job = {q, k, v, mask, raw, relpos, table, scale, n_kv*c/used, n_kv*(c + 1)/used,
+                                       (float *) ((char *) dst->data + c*dst->nb[3])};
+        if (!rg_fast || !llama_redgiant_attn_chunk_avx512(job)) {
+            rg_chunk_plain(job);
+        }
+    }
+}
+
+// Second op: the chunks merged, the sink added to the sum. dst: [D, n_head, n_batch, ne3].
+static void rg_merge_op(ggml_tensor * dst, int ith, int nth, void *) {
+    const ggml_tensor * parts = dst->src[0];
+    const ggml_tensor * sinks = dst->src[1];
+    const int64_t n_head = dst->ne[1], rows = dst->ne[1]*dst->ne[2]*dst->ne[3];
+    const float * pd = (const float *) parts->data;
+    const int64_t stride = rows*(RG_D + 2);
+    const int64_t used = parts->src[6] ? RG_CHUNKS : rg_chunks_used(parts->src[1]->ne[1], parts->src[0]->ne[1]*parts->src[0]->ne[3]);
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t h = r % n_head;
+        float m = -INFINITY;
+        for (int64_t c = 0; c < used; c++) {
+            const float * p = pd + c*stride + r*(RG_D + 2);
+            if (p[RG_D + 1] > 0.0f) {
+                m = std::max(m, p[RG_D]);
+            }
+        }
+        const float sink = sinks ? ((const float *) sinks->data)[h] : -INFINITY;
+        m = std::max(m, sink);
+        float * o = (float *) dst->data + r*RG_D;
+        std::fill(o, o + RG_D, 0.0f);
+        if (m == -INFINITY) {
+            continue;
+        }
+        float l = sinks ? std::exp(sink - m) : 0.0f;
+        for (int64_t c = 0; c < used; c++) {
+            const float * p = pd + c*stride + r*(RG_D + 2);
+            if (p[RG_D + 1] <= 0.0f) {
+                continue;
+            }
+            const float w = std::exp(p[RG_D] - m);
+            l += p[RG_D + 1]*w;
+            for (int64_t d = 0; d < RG_D; d++) {
+                o[d] += p[d]*w;
+            }
+        }
+        const float inv = l > 0.0f ? 1.0f/l : 0.0f;
+        for (int64_t d = 0; d < RG_D; d++) {
+            o[d] *= inv;
+        }
+    }
+}
+
+bool llama_redgiant_attn_supported(const ggml_tensor * k, const ggml_tensor * v, float max_bias, float softcap) {
+    const bool types = (k->type == GGML_TYPE_Q8_0 || k->type == GGML_TYPE_Q4_0) && v->type == k->type;
+    return types && k->ne[0] == RG_D && v->ne[0] == RG_D &&
+           max_bias == 0.0f && softcap == 0.0f;
+}
+
+ggml_tensor * llama_redgiant_attn_cpu(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * sinks,
+        float scale) {
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], ne3 = q->ne[3];
+    void * ud = nullptr;
+    std::memcpy(&ud, &scale, sizeof(float));
+    ggml_tensor * args[4] = {q, k, v, mask};
+    ggml_tensor * parts = ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D + 2, n_head, n_batch*ne3, RG_CHUNKS, args,
+                                         mask ? 4 : 3, rg_chunks_op, GGML_N_TASKS_MAX, ud);
+    ggml_tensor * margs[2] = {parts, sinks};
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D, n_head, n_batch, ne3, margs, sinks ? 2 : 1, rg_merge_op,
+                          GGML_N_TASKS_MAX, nullptr);
+}
+
+// The merged result of row r (query row x head) over the chunks: sum of weighted values, max score, softmax sum.
+static void rg_merge_row(const ggml_tensor * parts, int64_t r, int64_t rows, float * acc, float & m, float & l) {
+    const float * pd = (const float *) parts->data;
+    const int64_t stride = rows*(RG_D + 2);
+    const int64_t used = parts->src[6] ? RG_CHUNKS : rg_chunks_used(parts->src[1]->ne[1], parts->src[0]->ne[1]*parts->src[0]->ne[3]);
+    m = -INFINITY;
+    for (int64_t c = 0; c < used; c++) {
+        const float * p = pd + c*stride + r*(RG_D + 2);
+        if (p[RG_D + 1] > 0.0f) {
+            m = std::max(m, p[RG_D]);
+        }
+    }
+    l = 0.0f;
+    std::fill(acc, acc + RG_D, 0.0f);
+    if (m == -INFINITY) {
+        return;
+    }
+    for (int64_t c = 0; c < used; c++) {
+        const float * p = pd + c*stride + r*(RG_D + 2);
+        if (p[RG_D + 1] <= 0.0f) {
+            continue;
+        }
+        const float w = std::exp(p[RG_D] - m);
+        l += p[RG_D + 1]*w;
+        for (int64_t d = 0; d < RG_D; d++) {
+            acc[d] += p[d]*w;
+        }
+    }
+}
+
+// The processor's rows of values: dst [n_head_kv*D, group*n_batch], userdata = group.
+static void rg_vrows_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * parts = dst->src[0];
+    const int64_t group = (int64_t) (intptr_t) userdata;
+    const int64_t n_head = parts->ne[1], n_batch = parts->ne[2], rows = n_head*n_batch, n_head_kv = n_head/group;
+    float acc[RG_D];
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t t = r / n_head, h = r % n_head, kvh = h / group, g = h % group;
+        float m, l;
+        rg_merge_row(parts, r, rows, acc, m, l);
+        float * o = (float *) ((char *) dst->data + (t*group + g)*dst->nb[1]) + kvh*RG_D;
+        const float inv = l > 0.0f ? 1.0f/l : 0.0f;
+        for (int64_t d = 0; d < RG_D; d++) {
+            o[d] = acc[d]*inv;
+        }
+        GGML_UNUSED(n_head_kv);
+    }
+}
+
+// The mask of the processor's rows: dst [vpad, n_batch, n_head, 1] F16, userdata = group.
+static void rg_vmask_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const ggml_tensor * parts = dst->src[0];
+    const int64_t group = (int64_t) (intptr_t) userdata;
+    const int64_t n_head = parts->ne[1], n_batch = parts->ne[2], rows = n_head*n_batch, vpad = dst->ne[0];
+    const ggml_fp16_t ninf = ggml_fp32_to_fp16(-INFINITY);
+    float acc[RG_D];
+    for (int64_t r = ith; r < rows; r += nth) {
+        const int64_t t = r / n_head, h = r % n_head, g = h % group;
+        float m, l;
+        rg_merge_row(parts, r, rows, acc, m, l);
+        ggml_fp16_t * o = (ggml_fp16_t *) ((char *) dst->data + t*dst->nb[1] + h*dst->nb[2]);
+        for (int64_t j = 0; j < vpad; j++) {
+            o[j] = ninf;
+        }
+        if (l > 0.0f) {
+            o[t*group + g] = ggml_fp32_to_fp16(m + std::log(l));
+        }
+    }
+}
+
+// Selective reading (C.4 2(c), LLAMA_KV_SELECT=<pages>, approximate, while writing only): per page of 64 cold cells and
+// kv head, the minimum and maximum of every key dimension (kept across calls, recomputed only for pages that grew);
+// a page's score is the highest a query could reach there (sum over dims of max(q*min, q*max)), the best pages are read
+// exactly, with the first page and the last two always (Quest, Tang et al. 2024).
+struct rg_pages_state {
+    std::vector<float>   mn, mx;  // [page][kvh][D]
+    std::vector<int32_t> count;   // cells summarized in each page
+};
+static std::mutex rg_pages_mu;
+static std::unordered_map<const void *, rg_pages_state> rg_pages;
+
+static rg_pages_state & rg_pages_for(const void * key, int64_t n_pages, int64_t n_head_kv) {
+    std::lock_guard<std::mutex> lock(rg_pages_mu);
+    auto & st = rg_pages[key];
+    if ((int64_t) st.count.size() < n_pages) {
+        st.mn.resize(n_pages*n_head_kv*RG_D);
+        st.mx.resize(n_pages*n_head_kv*RG_D);
+        st.count.resize(n_pages, 0);
+    }
+    return st;
+}
+
+// Scores of the pages: dst [n_pages] F32. src: q, k.
+static void rg_score_op(ggml_tensor * dst, int ith, int nth, void *) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const int64_t n_kv = k->ne[1], n_pages = dst->ne[0], n_head_kv = k->ne[2];
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2], G = n_head/n_head_kv;
+    const bool q4 = k->type == GGML_TYPE_Q4_0;
+    rg_pages_state & st = rg_pages_for(k->data, n_pages, n_head_kv);
+    int8_t x8[32];
+    for (int64_t p = ith; p < n_pages; p += nth) {
+        const int32_t cnt = (int32_t) std::min<int64_t>(RG_PAGE, n_kv - p*RG_PAGE);
+        if (st.count[p] != cnt) {
+            for (int64_t kvh = 0; kvh < n_head_kv; kvh++) {
+                float * mn = &st.mn[(p*n_head_kv + kvh)*RG_D];
+                float * mx = &st.mx[(p*n_head_kv + kvh)*RG_D];
+                std::fill(mn, mn + RG_D, INFINITY);
+                std::fill(mx, mx + RG_D, -INFINITY);
+                for (int64_t c = p*RG_PAGE; c < p*RG_PAGE + cnt; c++) {
+                    const char * kr = (const char *) k->data + c*k->nb[1] + kvh*k->nb[2];
+                    for (int b = 0; b < RG_D/32; b++) {
+                        const float d = llama_redgiant_block(kr, b, q4, x8);
+                        for (int i = 0; i < 32; i++) {
+                            const float x = d*x8[i];
+                            mn[b*32 + i] = std::min(mn[b*32 + i], x);
+                            mx[b*32 + i] = std::max(mx[b*32 + i], x);
+                        }
+                    }
+                }
+            }
+            st.count[p] = cnt;
+        }
+        float best = -INFINITY;
+        for (int64_t t = 0; t < n_batch; t++) {
+            for (int64_t h = 0; h < n_head; h++) {
+                const int64_t kvh = h / G;
+                const float * qp = (const float *) ((const char *) q->data + t*q->nb[1] + h*q->nb[2]);
+                const float * mn = &st.mn[(p*n_head_kv + kvh)*RG_D];
+                const float * mx = &st.mx[(p*n_head_kv + kvh)*RG_D];
+                float ub = 0.0f;
+                for (int d = 0; d < RG_D; d++) {
+                    ub += std::max(qp[d]*mn[d], qp[d]*mx[d]);
+                }
+                best = std::max(best, ub);
+            }
+        }
+        ((float *) dst->data)[p] = best;
+    }
+}
+
+// The chosen pages: dst [RG_CHUNKS] I32, ascending, -1 for the empty ones. src: the scores. userdata: the budget.
+static void rg_select_op(ggml_tensor * dst, int ith, int, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    const ggml_tensor * sc = dst->src[0];
+    const int64_t n_pages = sc->ne[0];
+    const int64_t budget = std::min<int64_t>((int64_t) (intptr_t) userdata, RG_CHUNKS - 3);
+    int32_t * out = (int32_t *) dst->data;
+    std::vector<int32_t> pick;
+    if (n_pages <= budget + 3) {
+        for (int64_t p = 0; p < n_pages; p++) pick.push_back((int32_t) p);
+    } else {
+        // always the first page and the last two (the conversation's start, the newest cold cells)
+        std::vector<int32_t> rest;
+        for (int64_t p = 1; p < n_pages - 2; p++) rest.push_back((int32_t) p);
+        const float * s = (const float *) sc->data;
+        std::nth_element(rest.begin(), rest.begin() + budget, rest.end(), [s](int32_t a, int32_t b) { return s[a] > s[b]; });
+        pick.assign(rest.begin(), rest.begin() + budget);
+        pick.push_back(0);
+        pick.push_back((int32_t) (n_pages - 2));
+        pick.push_back((int32_t) (n_pages - 1));
+        std::sort(pick.begin(), pick.end());
+    }
+    for (int64_t i = 0; i < dst->ne[0]; i++) {
+        out[i] = i < (int64_t) pick.size() ? pick[i] : -1;
+    }
+}
+
+llama_redgiant_cold llama_redgiant_attn_cold(
+        ggml_context * ctx,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * raw,
+        ggml_tensor * relpos,
+        ggml_tensor * table,
+        float scale,
+        int64_t group,
+        int64_t vpad) {
+    GGML_ASSERT(q->ne[3] == 1 && "one stream (--kv-unified)");
+    const int64_t n_batch = q->ne[1], n_head = q->ne[2];
+    void * ud = nullptr;
+    std::memcpy(&ud, &scale, sizeof(float));
+    // selective reading only while writing (a row or a few): reading a message stays exact
+    const char * sel = getenv("LLAMA_KV_SELECT");
+    ggml_tensor * list = nullptr;
+    if (sel && atoi(sel) > 0 && n_batch < 4) {
+        const int64_t n_pages = (k->ne[1] + RG_PAGE - 1)/RG_PAGE;
+        ggml_tensor * sa[2] = {q, k};
+        ggml_tensor * scores = ggml_custom_4d(ctx, GGML_TYPE_F32, n_pages, 1, 1, 1, sa, 2, rg_score_op, GGML_N_TASKS_MAX, nullptr);
+        ggml_tensor * la[1] = {scores};
+        list = ggml_custom_4d(ctx, GGML_TYPE_I32, RG_CHUNKS, 1, 1, 1, la, 1, rg_select_op, 1, (void *) (intptr_t) atoi(sel));
+    }
+    ggml_tensor * args[7] = {q, k, v, relpos ? raw : mask, relpos, table, list};
+    const int n_args = list ? 7 : relpos ? 6 : (mask ? 4 : 3);
+    ggml_tensor * parts = ggml_custom_4d(ctx, GGML_TYPE_F32, RG_D + 2, n_head, n_batch, RG_CHUNKS, args,
+                                         n_args, rg_chunks_op, GGML_N_TASKS_MAX, ud);
+    ggml_tensor * pa[1] = {parts};
+    void * g = (void *) (intptr_t) group;
+    llama_redgiant_cold res;
+    res.vrows = ggml_custom_4d(ctx, GGML_TYPE_F32, (n_head/group)*RG_D, group*n_batch, 1, 1, pa, 1, rg_vrows_op,
+                               GGML_N_TASKS_MAX, g);
+    res.mask = ggml_custom_4d(ctx, GGML_TYPE_F16, vpad, n_batch, n_head, 1, pa, 1, rg_vmask_op, GGML_N_TASKS_MAX, g);
+    return res;
+}
